# Public site URL, used for metadata, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Coaching funnel links. Replace with your real booking + community links.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/your-handle/tft-coaching
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite

# Postgres connection string (Supabase, Neon, local, ...).
# Leave unset: the site renders from src/content until the crawler is online.
# DATABASE_URL=postgres://user:pass@host:5432/postgres

# ---------------------------------------------------------------------------
# Crawler (worker/)
# ---------------------------------------------------------------------------

# Riot API key. Server-side only. Never prefix with NEXT_PUBLIC_.
# Riot dev keys expire every 24 hours; production keys need an approved app.
# RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# development | production — selects the rate-limit ceiling (20/s vs 500/10s).
# RIOT_KEY_TYPE=development

# Fraction of the published limit to actually use. 65 leaves headroom for 429s.
# CRAWL_BUDGET_PERCENT=65

# RIOT_REGIONS=EUW,KR
# CRAWL_SEED_TIERS=challenger,grandmaster
# CRAWL_SEED_MAX_PLAYERS=2000
# CRAWL_CONCURRENCY=4
# CRAWL_DISCOVERY_WINDOW_HOURS=72
# CRAWL_PLAYERS_PER_RUN=150
# CRAWL_LOOP_INTERVAL_SECONDS=300

# Rehearse the whole pipeline with no API key against worker/dev/stub-riot.ts:
# RIOT_API_BASE_URL=http://127.0.0.1:4010
